Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.12.10
Stage: uv

Bootstrap: docker
From: python:3.12-slim-trixie
Stage: root

%files from uv
    /uv /usr/local/bin/uv

%files
    pyproject.toml /opt/root/pyproject.toml
    uv.lock /opt/root/uv.lock
    README.md /opt/root/README.md
    src /opt/root/src
    tests /opt/root/tests
    containers/test.sh /usr/local/bin/root-container-test

%post -c /bin/bash
    set -euo pipefail
    apt-get update
    apt-get install -y --no-install-recommends bash ca-certificates git libgomp1
    rm -rf /var/lib/apt/lists/*

    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_PYTHON_DOWNLOADS=never
    export UV_LINK_MODE=copy
    cd /opt/root
    uv sync --locked --extra dev --no-editable --no-cache
    chmod 755 /usr/local/bin/root-container-test
    mkdir -p /workspace /cache/huggingface
    chmod 1777 /workspace /cache /cache/huggingface

%environment
    export PATH="/opt/venv/bin:$PATH"
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export HF_HOME=/cache/huggingface

%test
    #!/bin/bash
    set -euo pipefail
    /opt/venv/bin/root --version
    export PATH="/opt/venv/bin:$PATH"
    root-container-test

%runscript
    #!/bin/bash
    set -euo pipefail
    exec /opt/venv/bin/root --engine transformers --device cuda "$@"

%help
    Build from the repository root:
        apptainer build --fakeroot root.sif containers/root.def
    Test without a GPU or model download:
        apptainer test --cleanenv root.sif
    Run inside an NVIDIA GPU allocation:
        apptainer run --cleanenv --nv root.sif "What is 17 times 23?"
    Bind a writable workspace and Hugging Face cache for persistent use.
    See docs/containers.md for mounts, development, and GPU checks.
